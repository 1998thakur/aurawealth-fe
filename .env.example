# Backend proxy target (server-side only — used by next.config.mjs rewrites)
BACKEND_URL=https://aurawealth-backend-production.up.railway.app

# Public API base path (relative — Next.js proxies /api/* to BACKEND_URL)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Site
NEXT_PUBLIC_SITE_URL=https://creditbrain.in
