# Backend proxy target (server-side only — used by next.config.mjs rewrites)
BACKEND_URL=https://aurawealth-backend-production-2faa.up.railway.app

# Public API base path (relative — Next.js proxies /api/* to BACKEND_URL)
NEXT_PUBLIC_API_BASE_URL=/api/v1

# Site
NEXT_PUBLIC_SITE_URL=https://creditbrain.in

# Supabase (direct DB queries for server-side rendering)
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_...
